{
  "name": "nhl-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot on Cloudflare Workers that posts confirmed NHL trades, waivers and signings.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply nhl-trade-tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply nhl-trade-tracker --remote",
    "register-commands": "tsx scripts/register-commands.ts",
    "eval": "tsx scripts/eval-classifier.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "zod": "^4.6.7"
  }
}
